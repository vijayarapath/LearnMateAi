# ---- Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata

# Allow people to register as teachers themselves (off: admins assign the teacher role)
TEACHER_SELF_SIGNUP=False

# ---- PostgreSQL (leave POSTGRES_DB empty to use SQLite)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Email (password reset). Default prints emails to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ---- Meta Model API. Fill these from the official documentation for your account.
META_API_BASE_URL=
META_API_KEY=
META_API_TIMEOUT=45
META_API_MAX_RETRIES=2
# Model identifiers and endpoint paths (relative to META_API_BASE_URL)
MUSE_SPARK_MODEL=
MUSE_SPARK_PATH=
MUSE_WONDER_MODEL=
MUSE_WONDER_PATH=
MUSE_IMAGE_MODEL=muse-image-1.0
MUSE_IMAGE_PATH=/images/generations
MUSE_VOICE_MODEL=
MUSE_VOICE_PATH=
SAM_MODEL=
SAM_PATH=

# ---- Optional self-hosted, OpenAI-compatible text server for open-weight models
TEXT_PROVIDER=spark
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_NAME=
LOCAL_MODEL_API_KEY=

# ---- Rate limits (requests per hour per user)
RATE_TUTOR_MAX=30
RATE_QUIZ_MAX=10
RATE_VISION_MAX=15
RATE_VOICE_MAX=20
RATE_IMAGE_MAX=8

# ---- Upload limits (MB)
MAX_IMAGE_UPLOAD_MB=8
MAX_AUDIO_UPLOAD_MB=10
MAX_MATERIAL_UPLOAD_MB=15

# ---- Retention
RETAIN_AI_LOG_DAYS=90
RETAIN_NOTIFICATION_DAYS=60
# REDIS_URL=redis://127.0.0.1:6379/1
